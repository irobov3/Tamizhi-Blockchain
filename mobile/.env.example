# ── Tamizhi Mobile — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# For EAS builds, add secrets via: eas secret:push --scope project

# ── Chain endpoints ────────────────────────────────────────────────────────────
# Tamizhi chain LCD (REST) endpoint
EXPO_PUBLIC_CHAIN_LCD=http://localhost:1317

# Chain ID (tamizhi-1 for testnet/mainnet, tamizhi-local-1 for local dev)
EXPO_PUBLIC_CHAIN_ID=tamizhi-1

# ── Off-chain services ─────────────────────────────────────────────────────────
# Tamizhi storage server (IPFS gateway / file server)
EXPO_PUBLIC_STORAGE_URL=http://localhost:8100

# Tamizhi onion router node (messaging relay)
EXPO_PUBLIC_ROUTER_URL=http://localhost:8101

# ── Optional ───────────────────────────────────────────────────────────────────
# Backend API base URL (if using the Node.js backend)
EXPO_PUBLIC_API_URL=http://localhost:4000

# AI service endpoint (Ollama or custom)
EXPO_PUBLIC_AI_URL=http://localhost:8000
