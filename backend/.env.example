# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tamizhi_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# Blockchain
CHAIN_RPC_URL="https://rpc.tamizhi.chain"
CHAIN_LCD_URL="https://lcd.tamizhi.chain"
CHAIN_ID="tamizhi-1"

# IPFS
IPFS_API_URL="http://localhost:5001"
IPFS_GATEWAY="https://ipfs.io/ipfs"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
