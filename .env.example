# ============================================================
# Tamizhi Ecosystem — Root Environment Template
# Copy to .env and fill in real values before running.
# ============================================================

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_DB=tamizhi
POSTGRES_USER=tamizhi
POSTGRES_PASSWORD=tamizhi_dev
DATABASE_URL=postgresql://tamizhi:tamizhi_dev@postgres:5432/tamizhi

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────
# Auth
# ─────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-generate-a-long-random-secret-before-deploying

# ─────────────────────────────────────────
# Chain endpoints (internal service names)
# ─────────────────────────────────────────
CHAIN_RPC=http://tamizhi-node:26657
CHAIN_REST=http://tamizhi-node:1317
CHAIN_GRPC=tamizhi-node:9090
CHAIN_ID=tamizhi-1

# ─────────────────────────────────────────
# AI / Anthropic
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-your-key

# ─────────────────────────────────────────
# IPFS / Storage
# ─────────────────────────────────────────
IPFS_NODE_URL=http://ipfs:5001

# ─────────────────────────────────────────
# Web (Next.js public vars — exposed to browser)
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_REST_URL=http://localhost:1317
NEXT_PUBLIC_WS_URL=ws://localhost:26657
NEXT_PUBLIC_CHAIN_RPC=http://localhost:26657
NEXT_PUBLIC_CHAIN_ID=tamizhi-1
NEXT_PUBLIC_MESSAGING_URL=ws://localhost:4000
NEXT_PUBLIC_STORAGE_URL=http://localhost:5000

# ─────────────────────────────────────────
# CosmWasm contract (set after deploy-contract.sh)
# ─────────────────────────────────────────
NEXT_PUBLIC_NFT_CONTRACT=

# ─────────────────────────────────────────
# IPFS pinning (production — server-side only)
# ─────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ─────────────────────────────────────────
# Postgres / service passwords (change before prod)
# ─────────────────────────────────────────
POSTGRES_PASSWORD=tamizhi_dev

# ─────────────────────────────────────────
# Messaging service
# ─────────────────────────────────────────
MESSAGING_PORT=4000

# ─────────────────────────────────────────
# AI service
# ─────────────────────────────────────────
AI_PORT=8000
# Optional local LLM via Ollama
OLLAMA_URL=http://localhost:11434
