# Tamizhi AI Service — Environment Variables

# Server
PORT=8000
HOST=0.0.0.0
WORKERS=1

# AI Provider Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=1

# JWT (shared with backend and messaging service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Backend API (for literature context fetching)
BACKEND_URL=http://localhost:3000
TAMIZHI_LCD_URL=https://lcd.tamizhi.network

# AI Model Configuration
DEFAULT_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7

# RAG Settings
LITERATURE_CONTEXT_MAX_WORKS=5
LITERATURE_CONTEXT_MAX_PASSAGE_LEN=500

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
MAX_TOKENS_PER_DAY=100000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Cache conversation history in Redis (TTL in seconds)
CONVERSATION_CACHE_TTL=3600
