# Tamizhi Web Application Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Cosmos Chain RPC Endpoint
NEXT_PUBLIC_CHAIN_RPC=http://localhost:26657

# Cosmos Chain LCD/REST Endpoint
NEXT_PUBLIC_CHAIN_LCD=http://localhost:1317

# Chain ID
NEXT_PUBLIC_CHAIN_ID=tamizhi-1

# IPFS Gateway URL
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# WebSocket URL for real-time messaging
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Literary NFT contract address (set after deploy-contract.sh runs)
NEXT_PUBLIC_NFT_CONTRACT=

# Optional: Pinata IPFS API (server-side only)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Optional: JWT Secret (server-side only)
JWT_SECRET=your_jwt_secret_key
