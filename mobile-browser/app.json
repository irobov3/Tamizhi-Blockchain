{
  "expo": {
    "name": "Tamizhi Browser",
    "slug": "tamizhi-browser",
    "version": "1.0.0",
    "scheme": "tamizhi-browser",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#040508"
    },
    "android": {
      "package": "ai.tamizhi.browser",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#040508"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "ai.tamizhi.browser",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Tamizhi Browser uses the local network to connect to your Tamizhi node.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock your built-in Tamizhi wallet.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
