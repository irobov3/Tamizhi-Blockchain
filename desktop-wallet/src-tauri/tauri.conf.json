{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tamizhi Wallet",
  "version": "0.1.0",
  "identifier": "ai.tamizhi.desktop.wallet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tamizhi Wallet",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "rpm", "msi", "nsis", "appimage"],
    "category": "Finance",
    "shortDescription": "Native desktop wallet for the Tamizhi chain",
    "longDescription": "Manage your TMZ tokens, stake to validators, view rewards, and submit literary works directly from your desktop.",
    "publisher": "Tamizhi Foundation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tamizhi"]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": ""
    }
  }
}
