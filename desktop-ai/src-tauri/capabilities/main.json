{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Main window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "notification:default",
    "shell:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "clipboard-manager:default",
    "global-shortcut:default"
  ]
}
