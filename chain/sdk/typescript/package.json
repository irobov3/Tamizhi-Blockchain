{
  "name": "@tamizhi/chain-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for interacting with the Tamizhi blockchain",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:unit": "jest --testPathPattern='(?<!integration)\\.test'",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["tamizhi", "cosmos", "blockchain", "cosmjs"],
  "license": "Apache-2.0",
  "dependencies": {
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "@cosmjs/tendermint-rpc": "^0.32.4",
    "cosmjs-types": "^0.9.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^9.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  }
}
