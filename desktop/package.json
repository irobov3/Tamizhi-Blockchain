{
  "name": "tamizhi-desktop",
  "version": "1.0.0",
  "description": "Tamizhi - Tamil blockchain wallet, private messenger & literature browser",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"webpack --config webpack.main.config.js --watch\" \"webpack --config webpack.renderer.config.js --watch\" \"wait-on dist/main/index.js dist/renderer/index.js && electron .\"",
    "build": "webpack --config webpack.main.config.js && webpack --config webpack.renderer.config.js",
    "package": "npm run build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.3.3",
    "better-sqlite3": "^11.1.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "@cosmjs/crypto": "^0.32.3",
    "@cosmjs/encoding": "^0.32.3",
    "@cosmjs/stargate": "^0.32.3",
    "@cosmjs/proto-signing": "^0.32.3",
    "axios": "^1.7.2",
    "socket.io-client": "^4.7.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "zustand": "^4.5.4",
    "framer-motion": "^11.2.12",
    "lucide-react": "^0.395.0",
    "date-fns": "^3.6.0",
    "qrcode": "^1.5.4",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "typescript": "^5.4.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "eslint": "^9.6.0"
  }
}
