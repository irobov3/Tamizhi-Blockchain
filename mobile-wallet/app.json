{
  "expo": {
    "name": "Tamizhi Wallet",
    "slug": "tamizhi-wallet",
    "version": "1.0.0",
    "scheme": "tamizhi-wallet",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#1a1040"
    },
    "android": {
      "package": "ai.tamizhi.wallet",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1040"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "ai.tamizhi.wallet",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Tamizhi Wallet uses your camera to scan QR codes for addresses.",
        "NSLocalNetworkUsageDescription": "Tamizhi Wallet uses the local network to connect to your Tamizhi node.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock your wallet and authorize transactions.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Tamizhi Wallet uses your camera to scan QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
