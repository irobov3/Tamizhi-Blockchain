{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tamizhi Browser",
  "version": "0.1.0",
  "identifier": "ai.tamizhi.desktop.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1423",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tamizhi Browser",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "rpm", "msi", "nsis", "appimage"],
    "category": "Network",
    "shortDescription": "Web3 browser for the Tamizhi network",
    "longDescription": "Tamizhi Browser is a Web3-aware desktop browser tied to the Tamizhi blockchain. Every page can request access to the built-in wallet via window.tamizhi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tamizhi-browser", "tamizhi"]
      }
    }
  }
}
