{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:event:default",
    "store:default",
    "shell:default",
    "shell:allow-open",
    "dialog:default",
    "deep-link:default"
  ]
}
